<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="ModeloComissoes">
      <ConnectionProperties>
        <DataProvider>PBIDATASET</DataProvider>
        <ConnectString>Data Source=pbiazure://api.powerbi.com/;Initial Catalog=modelo-comissoes;Integrated Security=ClaimsToken</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>None</rd:SecurityType>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="Extrato">
      <Query>
        <DataSourceName>ModeloComissoes</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="Ano">
            <Value>=Parameters!Ano.Value</Value>
          </QueryParameter>
          <QueryParameter Name="Vendedores">
            <Value>=Join(Parameters!Vendedores.Value, "|")</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>DEFINE
    VAR filtroAno =
        FILTER ( ALL ( fato_comissao[ano] ), ISBLANK ( @Ano ) || fato_comissao[ano] = @Ano )
    VAR filtroVendedor =
        FILTER (
            ALL ( dim_vendedor[vendedor_id] ),
            @Vendedores = "TODOS" || PATHCONTAINS ( @Vendedores, dim_vendedor[vendedor_id] )
        )

EVALUATE
SUMMARIZECOLUMNS (
    dim_item[ordem_grupo],
    dim_item[grupo],
    dim_item[chave_ordem],
    dim_item[codigo],
    dim_item[descricao],
    filtroAno,
    filtroVendedor,
    "Valor", [Total Comissão]
)
ORDER BY dim_item[chave_ordem]</CommandText>
      </Query>
      <Fields>
        <Field Name="ordem_grupo">
          <DataField>dim_item[ordem_grupo]</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
        <Field Name="grupo">
          <DataField>dim_item[grupo]</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="chave_ordem">
          <DataField>dim_item[chave_ordem]</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
        <Field Name="codigo">
          <DataField>dim_item[codigo]</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
        <Field Name="descricao">
          <DataField>dim_item[descricao]</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="valor">
          <DataField>[Valor]</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
  <ReportSections>
    <ReportSection>
      <Body>
        <ReportItems>
          <Tablix Name="TabelaExtrato">
            <TablixBody>
